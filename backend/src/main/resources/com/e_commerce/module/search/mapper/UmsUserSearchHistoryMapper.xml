<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.e_commerce.module.search.mapper.UmsUserSearchHistoryMapper">

    <select id="getUserHistoryKeywords" resultType="java.lang.String">
        SELECT keyword
        FROM ums_user_search_history
        WHERE user_id = #{userId}
        GROUP BY keyword
        ORDER BY MAX(search_time) DESC
        LIMIT 10
    </select>

</mapper>
